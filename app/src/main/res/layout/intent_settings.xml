<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView style="@style/Yanwai.SettingsCard">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView style="@style/Yanwai.Section" android:layout_marginTop="0dp" android:text="分析方式" />
    <TextView android:id="@+id/intentStatus" style="@style/Yanwai.Badge" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/emotionSourceLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="情绪分析">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/emotionSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" android:saveEnabled="false" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/emotionHint" style="@style/Yanwai.Caption" android:layout_marginTop="8dp" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/configSourceLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="LLM 配置来源">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/configSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" android:saveEnabled="false" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:id="@+id/reusedConfigPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/reusedConfigStatus" style="@style/Yanwai.Badge" android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/editReplyConfig" style="@style/Yanwai.Button.Text" android:text="配置回复模型" />
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/intentRouteLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="意图解析">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/intentRoute" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" android:saveEnabled="false" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/routeHint" style="@style/Yanwai.Caption" android:layout_marginTop="8dp" />
    <TextView style="@style/Yanwai.Caption" android:layout_marginTop="16dp" android:text="分析会将消息与相关前文发送给所选服务，仅供参考。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/saveIntent" style="@style/Yanwai.Button" android:layout_marginTop="16dp" android:text="保存分析方式" />
    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView style="@style/Yanwai.Section" android:text="模型连接" android:layout_marginTop="24dp" />
    <TextView android:id="@+id/connectionSummary" style="@style/Yanwai.Body" android:text="JEV 与 LLM 可随时单独配置。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/openModelSettings" style="@style/Yanwai.Button.Outline" android:layout_marginTop="12dp" android:text="管理模型连接" app:icon="@drawable/ic_settings" />
</LinearLayout>
