<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize" app:title="@string/app_name" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="连接你的模型" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
            <TextView android:id="@+id/textModelStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="请填写 API Key" android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutProvider"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:hint="模型渠道">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/inputProvider"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="none" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/textProviderGuide" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonGetKey"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="申请 API Key ↗" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonProviderDocs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="查看接入文档 ↗" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutApiBase"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="API 地址"
                app:helperText="已按渠道匹配，无需手动修改。">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputApiBase"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="textUri" android:maxLines="3"
                    android:importantForAutofill="no" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutApiModel"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="模型名" android:visibility="gone"
                app:helperText="按服务商文档填写，留空使用 jev-1.13.0。">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputApiModel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="textVisiblePassword" android:singleLine="true"
                    android:importantForAutofill="no" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutApiKey"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="API Key" app:endIconMode="password_toggle"
                app:helperText="填写当前所选渠道申请的 Key。">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputApiKey"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="textPassword" android:singleLine="true"
                    android:importantForAutofill="no" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Key 仅保存在本机。启用分析后，消息和相关前文将发送到填写的地址。自定义服务需兼容 Jev 协议。"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSaveApi"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="16dp" android:text="保存配置" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonTestModel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="4dp" android:text="保存并检测连接" />
            <TextView android:id="@+id/textTestResult" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite" android:visibility="gone"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="闲聊潜台词" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchEnabled"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="启用分析" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchBadge"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="在文字气泡下绘制分析结果" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="结合前文展示情绪概率，分别判断可能的潜台词和下一步建议。没有可靠选择就只显示情绪概率，模型判断仅供参考。只分析可见的对方纯文本，超过 1000 字符及媒体消息跳过。聊天右上角「绘制」控制显示，长按打开操作；关闭上方分析开关才停止新请求。不会替你回复。"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="使用状态" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView android:id="@+id/textFrameworkStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="首次使用：在 LSPosed 中启用本模块，作用域选择微信，然后重新启动微信。"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonDebug"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:minHeight="48dp" android:text="展开排查信息" />
            <LinearLayout android:id="@+id/debugPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchExplore"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:text="记录微信适配信息" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="这里显示本 APP 的检测记录；微信内的详细日志由电脑读取。修改适配开关后需重启微信。"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonRefreshLog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="刷新状态与记录" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonCopyLog"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="复制检测记录" />
                <TextView android:id="@+id/textLog" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textIsSelectable="true"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
