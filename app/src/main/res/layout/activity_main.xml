<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/page_background" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize"
        app:title="@string/app_name" app:subtitle="闲聊潜台词助手" app:titleTextColor="@color/text_primary"
        app:subtitleTextColor="@color/text_secondary" android:background="@color/page_background" />
    <androidx.core.widget.NestedScrollView android:id="@+id/pageScroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="12dp" android:paddingBottom="32dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/overviewCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/panel_surface" app:cardCornerRadius="24dp"
                app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/outline_subtle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView style="@style/Yanwai.Caption" android:text="使用概览"
                        android:textColor="@color/brand_primary" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/textOverviewTitle" style="@style/Yanwai.Body"
                        android:layout_marginTop="10dp" android:textSize="26sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" android:accessibilityHeading="true"
                        android:accessibilityLiveRegion="polite" android:text="先连接你的模型" />
                    <TextView android:id="@+id/textOverviewDescription" style="@style/Yanwai.Body"
                        android:layout_marginTop="8dp" android:text="选择一个渠道，填入 API Key，就可以开始检测。" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
                        <TextView style="@style/Yanwai.Body" android:layout_width="0dp" android:layout_weight="1"
                            android:text="模型连接" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/textModelBadge" style="@style/Yanwai.Badge" android:text="未配置" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                        <TextView style="@style/Yanwai.Body" android:layout_width="0dp" android:layout_weight="1"
                            android:text="微信模块" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/textHostBadge" style="@style/Yanwai.Badge" android:text="尚无运行记录" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonNextStep"
                        style="@style/Yanwai.Button" android:layout_marginTop="20dp" android:text="配置模型" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonJumpModel"
                        style="@style/Yanwai.Button.Text" android:text="查看模型设置" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Yanwai.Section" android:text="聊天分析" />
            <TextView style="@style/Yanwai.Caption"
                android:text="联系人和群聊默认关闭。进入聊天后，打开右上角「分析」，本地会记住这个聊天的选择。关闭后隐藏结果，并停止新的分析请求。" />

            <TextView android:id="@+id/modelSection" style="@style/Yanwai.Section" android:text="模型连接" />
            <TextView android:id="@+id/textModelStatus" style="@style/Yanwai.Body" android:text="先选择渠道，再填写对应的 API Key。" />
            <TextView android:id="@+id/textDraftStatus" style="@style/Yanwai.Badge"
                android:layout_marginTop="12dp" android:visibility="gone" android:text="有未保存修改" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutProvider"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="服务渠道">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/inputProvider"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="none" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/textProviderSummary" style="@style/Yanwai.Caption"
                android:layout_marginTop="8dp" android:text="预设渠道已匹配地址与模型，只需填写 Key。" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutApiBase"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="API 地址" android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputApiBase"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="textUri" android:maxLines="3"
                    android:importantForAutofill="no" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutApiModel"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="模型名" android:visibility="gone"
                app:helperText="按服务商文档填写，留空使用 jev-1.13.0。">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputApiModel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="textVisiblePassword" android:singleLine="true"
                    android:importantForAutofill="no" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutApiKey"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="API Key" app:endIconMode="password_toggle"
                app:helperText="使用当前渠道申请的 Key，仅保存在本机。">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputApiKey"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:inputType="textPassword" android:singleLine="true"
                    android:importantForAutofill="no" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonProviderHelp"
                style="@style/Yanwai.Button.Text" android:text="没有 Key？查看获取方法" />
            <LinearLayout android:id="@+id/providerHelpPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
                android:background="@drawable/status_pill" android:padding="16dp">
                <TextView android:id="@+id/textProviderGuide" style="@style/Yanwai.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonGetKey"
                    style="@style/Yanwai.Button.Outline" android:layout_marginTop="12dp" android:text="前往申请 Key ↗" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonProviderDocs"
                    style="@style/Yanwai.Button.Text" android:text="查看渠道文档 ↗" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonTestModel"
                style="@style/Yanwai.Button" android:layout_marginTop="16dp" android:text="保存并检测连接" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSaveApi"
                style="@style/Yanwai.Button.Text" android:text="仅保存配置" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressModel"
                android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"
                android:visibility="gone" app:trackCornerRadius="2dp" android:contentDescription="正在检测模型连接" />
            <TextView android:id="@+id/textTestResult" style="@style/Yanwai.Body"
                android:layout_marginTop="12dp" android:padding="16dp" android:background="@drawable/status_pill"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView style="@style/Yanwai.Caption" android:layout_marginTop="12dp"
                android:text="开启分析后，消息和相关前文将发送到所选服务。仅分析可见的对方纯文本，跳过媒体及超过 1000 字的消息，不会自动回复。" />

            <TextView android:id="@+id/wechatSection" style="@style/Yanwai.Section" android:text="微信中的使用情况" />
            <TextView android:id="@+id/textFrameworkStatus" style="@style/Yanwai.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSetupGuide"
                style="@style/Yanwai.Button.Text" android:layout_marginTop="8dp" android:text="首次使用 / 未生效？查看步骤" />
            <LinearLayout android:id="@+id/setupGuidePanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
                android:padding="16dp" android:background="@drawable/status_pill">
                <TextView style="@style/Yanwai.Body" android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary" android:text="01  连接模型" />
                <TextView style="@style/Yanwai.Body" android:layout_marginTop="4dp"
                    android:text="选择渠道、填入 Key，点击「保存并检测连接」。" />
                <TextView style="@style/Yanwai.Body" android:layout_marginTop="16dp" android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary" android:text="02  启用微信模块" />
                <TextView style="@style/Yanwai.Body" android:layout_marginTop="4dp"
                    android:text="在 LSPosed 中启用言外，作用域勾选微信，然后彻底关闭并重新打开微信。" />
                <TextView style="@style/Yanwai.Body" android:layout_marginTop="16dp" android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary" android:text="03  打开一个聊天" />
                <TextView style="@style/Yanwai.Body" android:layout_marginTop="4dp"
                    android:text="打开聊天，按需开启右上角「分析」。每个聊天单独记住选择；长按开关可查看操作或导出日志。" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonOpenWechat"
                    style="@style/Yanwai.Button.Outline" android:layout_marginTop="12dp" android:text="打开微信" />
            </LinearLayout>

            <TextView style="@style/Yanwai.Section" android:text="遇到问题" />
            <TextView style="@style/Yanwai.Body" android:text="先复现一次，再导出日志。问题自行恢复后，也可以查看之前的记录。" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonExportLog"
                style="@style/Yanwai.Button.Outline" android:layout_marginTop="12dp" android:text="导出运行日志" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonDebug"
                style="@style/Yanwai.Button.Text" android:text="查看详细排查信息" />
            <LinearLayout android:id="@+id/debugPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Yanwai.Caption"
                    android:text="桌面页包含本应用日志和微信最近上报的记录。若未收到微信日志，请在微信内长按「分析」或「言外」入口直接导出。" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchExplore"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:text="记录微信适配信息" />
                <TextView style="@style/Yanwai.Caption" android:text="排查版本兼容问题时开启，重启微信后生效。" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonRefreshLog"
                    style="@style/Yanwai.Button.Text" android:text="刷新状态与日志" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonCopyLog"
                    style="@style/Yanwai.Button.Text" android:text="复制完整日志" />
                <TextView android:id="@+id/textLog" style="@style/Yanwai.Caption"
                    android:textIsSelectable="true" android:fontFamily="monospace" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="28dp" android:background="@color/outline_subtle" />
            <TextView style="@style/Yanwai.Section" android:layout_marginTop="24dp" android:text="关于与更新" />
            <TextView android:id="@+id/textUpdateStatus" style="@style/Yanwai.Caption" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonCheckUpdate"
                style="@style/Yanwai.Button.Text" android:text="检查更新" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonReleasePage"
                style="@style/Yanwai.Button.Text" android:text="GitHub 发布页 ↗" />
            <TextView style="@style/Yanwai.Section" android:text="联系作者" />
            <TextView style="@style/Yanwai.Body" android:text="使用反馈或交流建议，可以添加作者微信。" />
            <ImageView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:adjustViewBounds="true" android:maxHeight="280dp"
                android:scaleType="fitCenter" android:src="@drawable/author_wechat_qr"
                android:contentDescription="作者微信二维码，微信号 YIRC99" />
            <TextView style="@style/Yanwai.Body" android:layout_marginTop="12dp"
                android:gravity="center" android:text="作者微信：YIRC99" android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" android:textIsSelectable="true" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonCopyAuthor"
                style="@style/Yanwai.Button.Text" android:text="复制作者微信号" />

            <TextView style="@style/Yanwai.Section" android:text="免费与开源" />
            <TextView style="@style/Yanwai.Badge" android:text="言外完全免费"
                android:textColor="@color/status_success" android:backgroundTint="@color/status_success_bg" />
            <TextView style="@style/Yanwai.Body" android:layout_marginTop="12dp"
                android:text="本项目不收费，没有会员或付费解锁。\n第三方模型服务可能按其规则收费，费用不属于言外。" />
            <TextView style="@style/Yanwai.Caption" android:layout_marginTop="16dp" android:text="项目开源地址" />
            <TextView style="@style/Yanwai.Body" android:layout_marginTop="4dp"
                android:text="https://github.com/YIRC99/yanwai" android:textColor="@color/brand_primary"
                android:textIsSelectable="true" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonOpenSource"
                style="@style/Yanwai.Button.Outline" android:layout_marginTop="8dp" android:text="查看开源代码 ↗" />
            <TextView style="@style/Yanwai.Caption" android:layout_marginTop="16dp"
                android:text="理解多一种可能，不替你下结论。\n模型判断仅供参考。" android:gravity="center" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
