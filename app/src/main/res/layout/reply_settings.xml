<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView style="@style/Yanwai.Section" android:layout_marginTop="20dp" android:text="回复模型" />
    <TextView style="@style/Yanwai.Body" android:text="「帮我回」和「找找话题」共用这份模型配置。" />
    <TextView android:id="@+id/replyStatus" style="@style/Yanwai.Badge" android:layout_marginTop="12dp" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/providerLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="供应商">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/provider" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/providerHint" style="@style/Yanwai.Caption" android:layout_marginTop="8dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/providerConsole" style="@style/Yanwai.Button.Text" android:text="去官方平台获取 Key ↗" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/endpointLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="API 地址" app:helperText="填写服务商的 Base URL（如 https://example.com/v1）或完整 /chat/completions 地址。">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textUri" android:maxLines="3" android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/keyLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="API Key" app:endIconMode="password_toggle" app:helperText="填写这个服务商的 Key，仅保存在本机。">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/fetchModels" style="@style/Yanwai.Button.Outline" android:layout_marginTop="12dp" android:text="获取模型列表" />
    <TextView android:id="@+id/modelsStatus" style="@style/Yanwai.Caption" android:accessibilityLiveRegion="polite" android:text="填写 Key 后获取，或直接输入模型 ID。" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/modelLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="选择模型 / 输入模型 ID" app:helperText="输入名称可筛选列表，也可手动填写。请选择支持长上下文的聊天模型。">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/model" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textVisiblePassword" android:completionThreshold="0" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/referenceModels" style="@style/Yanwai.Button.Text" android:visibility="gone" android:text="选择官方文档中的参考模型" />
    <TextView style="@style/Yanwai.Caption" android:layout_marginTop="16dp" android:text="点击生成时，相关聊天、对方背景和本次要求会发送给所选模型。建议只供复制，由你粘贴发送。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/testReply" style="@style/Yanwai.Button" android:layout_marginTop="16dp" android:text="保存并检测回复" />
    <TextView style="@style/Yanwai.Caption" android:text="检测会发送示例聊天和相关知识资料，可能产生 API 费用，不读取微信消息。列表可见不代表一定能调用。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/saveReply" style="@style/Yanwai.Button.Text" android:text="仅保存配置" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressReply" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" android:contentDescription="正在检测回复模型" />
    <TextView android:id="@+id/replyResult" style="@style/Yanwai.Body" android:layout_marginTop="12dp" android:padding="16dp" android:background="@drawable/status_pill" android:visibility="gone" android:accessibilityLiveRegion="polite" android:textIsSelectable="true" />
</LinearLayout>