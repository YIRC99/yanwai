<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:visibility="gone">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
        android:layout_height="wrap_content" app:cardBackgroundColor="@color/panel_surface"
        app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/outline_subtle">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/Yanwai.Caption" android:text="回复建议 · LLM"
                android:textColor="@color/brand_primary" android:fontFamily="sans-serif-medium" />
            <TextView style="@style/Yanwai.Body" android:text="想好这次怎么回"
                android:textSize="26sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
            <TextView style="@style/Yanwai.Body" android:layout_marginTop="8dp"
                android:text="在聊天输入框上方点「帮我回」，结合整段聊天给一句自然的建议。填入后，你可以修改，再自己发送。" />
            <TextView android:id="@+id/replyStatus" style="@style/Yanwai.Badge"
                android:layout_marginTop="16dp" android:text="尚未配置" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView style="@style/Yanwai.Section" android:text="连接回复模型" />
    <TextView style="@style/Yanwai.Body" android:text="选供应商，填入 Key，再获取并选择模型。每家的配置分别保存，与情绪判断互不影响。" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/providerLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:hint="供应商">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/provider"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="none" android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/providerHint" style="@style/Yanwai.Caption" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/providerAddress" style="@style/Yanwai.Caption"
        android:layout_marginTop="8dp" android:textIsSelectable="true" />
    <com.google.android.material.button.MaterialButton android:id="@+id/providerConsole"
        style="@style/Yanwai.Button.Text" android:text="去官方平台获取 Key ↗" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/endpointLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="API 地址"
        app:helperText="填写服务商的 Base URL（如 https://example.com/v1）或完整 /chat/completions 地址。">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/endpoint"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="textUri" android:maxLines="3" android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/keyLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="API Key"
        app:endIconMode="password_toggle" app:helperText="填写这个服务商的 Key，仅保存在本机。">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/apiKey"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="textPassword" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/fetchModels"
        style="@style/Yanwai.Button.Outline" android:layout_marginTop="12dp" android:text="获取模型列表" />
    <TextView android:id="@+id/modelsStatus" style="@style/Yanwai.Caption"
        android:accessibilityLiveRegion="polite" android:text="填写 Key 后获取，或直接输入模型 ID。" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/modelLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="选择模型 / 输入模型 ID"
        app:helperText="输入名称可筛选列表，也可手动填写。请选择支持长上下文的聊天模型。">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/model"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="textVisiblePassword" android:completionThreshold="0" android:singleLine="true"
            android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/referenceModels"
        style="@style/Yanwai.Button.Text" android:visibility="gone" android:text="选择官方文档中的参考模型" />
    <TextView style="@style/Yanwai.Section" android:text="由你决定何时使用" />
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/replyConsent"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:text="允许手动生成回复建议" android:saveEnabled="false" />
    <TextView style="@style/Yanwai.Caption" android:text="开启后，只有点「帮我回」或更新建议时，才会把当前聊天片段、发送人、时间、草稿和补充想法发送到上面配置的服务。不会自动生成或发送消息。修改此开关后需保存。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/testReply"
        style="@style/Yanwai.Button" android:layout_marginTop="16dp" android:text="保存并检测回复" />
    <TextView style="@style/Yanwai.Caption" android:text="检测会发送示例聊天和完整知识资料，可能产生 API 费用，不读取微信消息。列表可见不代表一定能调用。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/saveReply"
        style="@style/Yanwai.Button.Text" android:text="仅保存配置" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressReply"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"
        android:visibility="gone" android:contentDescription="正在检测回复模型" />
    <TextView android:id="@+id/replyResult" style="@style/Yanwai.Body" android:layout_marginTop="12dp"
        android:padding="16dp" android:background="@drawable/status_pill" android:visibility="gone"
        android:accessibilityLiveRegion="polite" android:textIsSelectable="true" />
    <TextView style="@style/Yanwai.Body" android:layout_marginTop="16dp"
        android:text="默认参考最近最多 100 条已加载消息，文字总长最多 48,000 字符。不会读取完整聊天数据库；媒体内容不参与理解。实际参考范围会在回复面板里展示。" />
    <TextView style="@style/Yanwai.Section" android:text="回复逻辑来自狗头军师" />
    <TextView style="@style/Yanwai.Body" android:text="基于开源项目 goutoujunshi 的回复流程与知识资料，覆盖恋爱、暧昧、关系沟通等场景。原始知识完整随应用打包，由你配置的 LLM 生成回复，言外负责聊天上下文和交互适配。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/knowledgeSource"
        style="@style/Yanwai.Button.Outline" android:layout_marginTop="12dp" android:text="了解狗头军师 ↗" />
    <TextView style="@style/Yanwai.Caption" android:layout_marginTop="8dp"
        android:text="MIT License · Copyright (c) 2026 powerycy\n知识版本：6db7354 · 模型建议仅供参考。" />
    <com.google.android.material.button.MaterialButton android:id="@+id/knowledgeLicense"
        style="@style/Yanwai.Button.Text" android:text="查看开源许可" />
</LinearLayout>
