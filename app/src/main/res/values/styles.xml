<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Yanwai.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Yanwai.Section" parent="Yanwai.Body">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Yanwai.Caption" parent="Yanwai.Body">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Yanwai.Badge" parent="Yanwai.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/status_pill</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
    <style name="Yanwai.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Yanwai.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Yanwai.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Yanwai.PageTitle" parent="Yanwai.Section">
        <item name="android:textSize">26sp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Yanwai.Entry" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Yanwai.SettingsCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item><item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/panel_surface</item><item name="strokeColor">@color/outline_subtle</item><item name="cardElevation">0dp</item>
    </style>
    <style name="Yanwai.ModelTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item>
        <item name="android:minHeight">52dp</item><item name="android:paddingHorizontal">8dp</item><item name="android:textSize">13sp</item><item name="android:textAllCaps">false</item>
    </style>
    <style name="Yanwai.NavigationLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Yanwai.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/status_success_bg</item>
    </style>
</resources>